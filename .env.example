# OpenAI — ChatGPT (сырой POST …/v1/chat/completions, в ответе usage)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Опционально: только исходящие запросы к OpenAI через HTTP(S) прокси (http://host:port)
# OPENAI_PROXY=

# DeepSeek (POST …/chat/completions)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_PROXY=

# Perplexity (по умолчанию POST /v1/sonar; через Polza — PERPLEXITY_BASE_URL + perplexity/sonar)
PERPLEXITY_API_KEY=
# PERPLEXITY_BASE_URL=https://polza.ai/api/v1
# PERPLEXITY_MODEL=perplexity/sonar
# PERPLEXITY_API_URL=https://api.perplexity.ai/v1/sonar
# PERPLEXITY_PROXY=

# Google Gemini (по умолчанию AI Studio; через Polza — GOOGLE_BASE_URL + google/gemini-…)
GOOGLE_AI_API_KEY=
# GOOGLE_BASE_URL=https://polza.ai/api/v1
# GOOGLE_GEMINI_MODEL=google/gemini-3.7-flash
# GOOGLE_AI_PROXY=

# Yandex Cloud — Алиса AI LLM (по умолчанию Responses API; через Polza — ALICE_BASE_URL)
# ALICE_BASE_URL=https://polza.ai/api/v1
# ALICE_API_KEY=
# ALICE_MODEL=yandex/aliceai-llm
YANDEX_CLOUD_FOLDER_ID=
YANDEX_CLOUD_API_KEY=
# Исходящий прокси для Алисы LLM и (если не задан YANDEX_GEN_SEARCH_PROXY) для генеративного поиска
# YANDEX_CLOUD_PROXY=
YANDEX_CLOUD_MODEL=aliceai-llm/latest
# YANDEX_RESPONSES_URL=https://ai.api.cloud.yandex.net/v1/responses

# --- Polza.ai: один ключ на 5 моделей (alice_search — только Yandex Search API ниже) ---
# POLZA_API_KEY=pk-...
# При *_BASE_URL=https://polza.ai/api/v1 используется POLZA_API_KEY (старые OPENAI_API_KEY и др. игнорируются).
# OPENAI_BASE_URL=https://polza.ai/api/v1
# OPENAI_MODEL=openai/gpt-5.4
# DEEPSEEK_API_KEY=<тот же ключ>
# DEEPSEEK_BASE_URL=https://polza.ai/api/v1
# DEEPSEEK_MODEL=deepseek/deepseek-v3.2
# PERPLEXITY_API_KEY=<тот же ключ>
# PERPLEXITY_BASE_URL=https://polza.ai/api/v1
# PERPLEXITY_MODEL=perplexity/sonar
# GOOGLE_AI_API_KEY=<тот же ключ>
# GOOGLE_BASE_URL=https://polza.ai/api/v1
# GOOGLE_GEMINI_MODEL=google/gemini-3.7-flash
# ALICE_API_KEY=<тот же ключ>
# ALICE_BASE_URL=https://polza.ai/api/v1
# ALICE_MODEL=yandex/aliceai-llm

# Yandex Cloud Search API — генеративный ответ по веб-поиску (провайдер alice_search).
# Баланс в ЛК (Billing API). Search API-ключ сюда не подходит.
# Удобнее всего OAuth аккаунта Яндекса (приложение «Yandex.Cloud»):
#   https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb
# YANDEX_OAUTH_TOKEN=
# Или короткий IAM (~12 ч): yc iam create-token
# YANDEX_IAM_TOKEN=
# YANDEX_BILLING_ACCOUNT_ID=   # опционально, если list недоступен
# По умолчанию те же YANDEX_CLOUD_*; при необходимости задайте отдельно:
# YANDEX_GEN_SEARCH_FOLDER_ID=
# YANDEX_GEN_SEARCH_API_KEY=
# YANDEX_GEN_SEARCH_URL=https://searchapi.api.cloud.yandex.net/v2/gen/search
# YANDEX_GEN_SEARCH_SEARCH_TYPE=SEARCH_TYPE_RU
# Отдельный прокси только для Search API (иначе — YANDEX_CLOUD_PROXY)
# YANDEX_GEN_SEARCH_PROXY=

# Опционально: модель Gemini (по умолчанию цепочка: 2.5-flash → lite → flash-latest → 2.5-pro; без 2.0-flash для новых ключей)
# GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Параллельных «пользовательских» запросов в пакете (1–16, по умолчанию 4)
# BATCH_QUERY_CONCURRENCY=4

# Параллельных ячеек (запрос × модель) в потоке SSE /api/query/stream (1–24, по умолчанию 12)
# STREAM_CELL_CONCURRENCY=12

# Опционально: защита POST /api/query для внешних вызовов (Postman, скрипты). Без ключа — как раньше, без проверки.
# API_SECRET=длинный-случайный-секрет
# Тогда: Authorization: Bearer <секрет>  или  X-API-Key: <секрет>

# Опционально: HTTP Basic только для сайта (/, статика, /openapi.json, /api-docs/) — не для /api/* (там свой Bearer при API_SECRET).
# SITE_BASIC_AUTH_USER=
# SITE_BASIC_AUTH_PASSWORD=

# Логи (JSONL, одна строка = один JSON). Каталог и файл создаются сами; файл можно удалить — появится снова.
# LOG_DIR=./logs
# LOG_FILE=app.log
# LOG_LEVEL=info
# Уровни: debug | info | warn | error (debug — ещё и усечённые превью тел POST /api/query*)
# За nginx оставьте доверие к X-Forwarded-For (по умолчанию включено). Локально без прокси: TRUST_PROXY=0
# TRUST_PROXY=0

# --- Личный кабинет / PostgreSQL (обязательно для входа и регистрации) ---
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ai_searcher
# Секреты (без них логин после регистрации не сработает):
#   openssl rand -hex 32   → вставить в JWT_SECRET (≥32 символа)
#   openssl rand -hex 32   → вставить в APP_ENCRYPTION_KEY (ровно 64 hex — удобно)
# JWT_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# APP_ENCRYPTION_KEY=
# PUBLIC_BASE_URL=https://gpt.seo-performance.ru
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=0
# COOKIE_SECURE=1
# DEFAULT_STARTING_BALANCE=100
# DEFAULT_QUERY_COST=1
# EMAIL_VERIFICATION_REQUIRED=1
# PG_BACKUP_DIR=./backups/postgres
# PG_BACKUP_RETENTION_DAYS=14
# AUDIT_LOG_DIR=./logs
# AUDIT_LOG_FILE=audit.log

# --- Robokassa (пополнение баланса) ---
# Тариф сейчас: 1 RUB = 1 токен (например 100 RUB = 100 токенов).
# Настройте в личном кабинете Робокассы Result URL на:
#   <PUBLIC_BASE_URL>/api/payments/robokassa/result
# И укажите методы (обычно POST).
# ROBOKASSA_MERCHANT_LOGIN=
# ROBOKASSA_PASSWORD1=
# ROBOKASSA_PASSWORD2=
# ROBOKASSA_IS_TEST=1
# ROBOKASSA_BASE_URL=https://auth.robokassa.ru/Merchant/Index.aspx